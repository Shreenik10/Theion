# TheiaXR environment variables.
# Copy this file to .env (never committed) and fill in values locally.
# Secrets live only on the server. Nothing here is ever sent to a browser or headset.
# `pnpm dev:mock` needs none of these: it reads no .env and makes no external calls.

# ---- Server
HOST=127.0.0.1
PORT=3001
# 1 = use Mock providers for everything (same as `pnpm dev:mock`)
MOCK_MODE=

# ---- Database (SQLite via Drizzle for development; Postgres for the pilot)
DATABASE_URL=

# ---- Claude (Anthropic API)
ANTHROPIC_API_KEY=

# ---- One model setting per agent (master prompt section 8.14)
# Check the current model list in the Anthropic documentation before filling these in.
# Fast model: replies must be quick and cheap.
PATIENT_MODEL=
STUDENT_MODEL=
# Strongest available model: building cases, judging, reviewing.
SCENARIO_MODEL=
SCORER_MODEL=
REVIEWER_MODEL=

# ---- Provider choice per interface (master prompt section 7): mock | real vendor id
SPEECH_TO_TEXT_PROVIDER=mock   # mock | deepgram | assemblyai | elevenlabs
PATIENT_LLM_PROVIDER=mock      # mock | anthropic
TEXT_TO_SPEECH_PROVIDER=mock   # mock | elevenlabs | azure
SCORER_PROVIDER=mock           # mock | anthropic
AVATAR_PROVIDER=mock           # mock | heygen | anam

# ---- Vendor keys (shortlist in section 7; tested in ticket B6 before anything is paid for)
HEYGEN_API_KEY=
ANAM_API_KEY=
ELEVENLABS_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
DEEPGRAM_API_KEY=
ASSEMBLYAI_API_KEY=
